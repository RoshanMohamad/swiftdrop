// Notification module-owned schema (M09: Notifications & Realtime).
// Raw SQL migration reference: packages/db/prisma/migrations/notification_init.sql.

/// Tracks per-consumer processing and duplicate suppression for outbox events.
model ProcessedEvent {
  id             String    @id @default(uuid()) @db.Uuid
  consumer       String    @db.VarChar(80)
  eventId        String    @map("event_id") @db.Uuid
  status         String    @db.VarChar(16) // PROCESSING | DONE | FAILED
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([consumer, eventId])
  @@map("processed_events")
}

/// Stores notification attempts with masked recipient identifiers only.
model NotificationLog {
  id              String    @id @default(uuid()) @db.Uuid
  eventId         String    @map("event_id") @db.Uuid // Logical FK to processed_events.event_id; intentionally not enforced.
  channel         String    @db.VarChar(8) // EMAIL | SMS
  templateId      String    @map("template_id") @db.VarChar(80)
  recipientMasked String    @map("recipient_masked") @db.VarChar(254)
  status          String    @db.VarChar(8) // SENT | FAILED | SKIPPED
  providerMsgId   String?   @map("provider_msg_id") @db.VarChar(255)
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(3)
  errorMsg        String?   @map("error_msg") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("notification_logs")
}
