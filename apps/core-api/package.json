{
  "name": "core-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --selectProjects unit",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --selectProjects integration unit --runInBand --coverage",
    "cleanup": "tsx src/cleanup.ts",
    "admin:create": "tsx src/admin-create.ts",
    "services:cli": "tsx src/services-cli.ts"
  },
  "dependencies": {
    "@swiftdrop/contracts": "workspace:*",
    "@swiftdrop/db": "workspace:*",
    "@swiftdrop/messaging": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "amqplib": "^2.2.0",
    "bcrypt": "6.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "4.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "minio": "^8.0.5",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "openid-client": "^6.8.8",
    "pino": "^10.4.0",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "testcontainers": "^11.8.0",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.0"
  }
}
